# Keep media and generated films out of Git — they can be large and/or
# rights-sensitive. Rules match by folder rather than file type, so any
# format the engine accepts (now or later) is covered. Paths are relative
# to local-media/; the leading * is one topic folder.
*/assets/*/*
*/titles/*/*
*/artifacts/*

# Keep the folder structure and the plain-language READMEs in the repo.
# A topic is only discovered if its assets/ and artifacts/ folders exist.
!*/assets/*/.gitkeep
!*/titles/*/README.txt
!*/artifacts/.gitkeep
